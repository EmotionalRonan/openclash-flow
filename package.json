{
  "name": "react-example",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "sync:version": "node ./scripts/sync-version.js",
    "bump": "node ./scripts/bump-version.js auto",
    "bump:auto": "node ./scripts/bump-version.js auto",
    "bump:patch": "node ./scripts/bump-version.js patch",
    "bump:minor": "node ./scripts/bump-version.js minor",
    "bump:release": "node ./scripts/bump-version.js release",
    "build:ipk": "node ./scripts/sync-version.js && bash ./scripts/build-ipk.sh all-arch",
    "build:ipk:all": "bash ./scripts/build-ipk.sh all",
    "build:ipk:x86": "bash ./scripts/build-ipk.sh x86_64",
    "build:ipk:aarch64": "bash ./scripts/build-ipk.sh aarch64_generic",
    "build:ipk:arm": "bash ./scripts/build-ipk.sh arm_cortex-a7_neon-vfpv4",
    "build:ipk:mipsel": "bash ./scripts/build-ipk.sh mipsel_24kc",
    "build:ipk:mips": "bash ./scripts/build-ipk.sh mips_24kc",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-yaml": "^5.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
